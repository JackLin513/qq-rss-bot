# ===== QQ 开放平台（q.qq.com → 你的机器人 → 开发设置）=====
QQ_BOT_APPID=102000000
QQ_BOT_SECRET=在你的开发设置页复制
# 沙箱环境开关：true 时走沙箱域名，测试阶段建议 true
QQ_BOT_SANDBOX=false

# ===== RSSHub =====
# 实测（2026-10）：官方公共实例 rsshub.app 已对本项目返回 HTTP 403，不能用。
# 两个可用方案，二选一：
#   1) 自建（推荐）：docker run -d --name rsshub -p 1200:1200 diygod/rsshub
#      然后填 RSSHUB_BASE=http://127.0.0.1:1200
#   2) 临时用公共镜像：RSSHUB_BASE=https://rsshub.rssforever.com （实测可用，但随时可能失效）
RSSHUB_BASE=http://127.0.0.1:1200

# ===== 轮询行为 =====
# 默认轮询间隔（秒），单个订阅可用 /sub 时覆盖
DEFAULT_INTERVAL_SEC=900
# 调度器扫描间隔（秒）
TICK_SEC=30
# 单次抓取超时（秒）
FETCH_TIMEOUT_SEC=20
# 一次推送最多带几条新条目，避免刷屏
MAX_ITEMS_PER_PUSH=5

# ===== 数据库 =====
DB_PATH=data/bot.db

# 日志等级：INFO 常规；DEBUG 能看到被忽略的非 @ 消息，排查事件问题用
LOG_LEVEL=INFO

# 推送时是否附带条目配图（true 时每条新闻单独发一条图文）
ATTACH_IMAGES=true

# 是否限制 /sub 与 /unsub 仅群主/管理员可用（false = 谁都能用）
RESTRICT_ADMIN_COMMANDS=true

# 群里有人分享 bilibili 链接时，自动回一张带封面/标题/播放数据的卡片。
# 走被动回复（不占主动消息配额）。解析不出来就静默不回，不会打扰群。
BILIBILI_PREVIEW=true

# 群里有人分享 YouTube / X(Twitter) 链接时，同样自动回卡片。
# 这两个站点**国内直连不通**，必须配下面的 MEDIA_PROXY，否则必然解析失败，
# 而且是**静默失败** —— 群里看不到任何报错，只有日志里有痕迹。
YOUTUBE_PREVIEW=true
TWITTER_PREVIEW=true

# 一条分享带**多张图**（推文多图 / 一条 RSS 资讯多图）。关掉就只发第一张。
# 两个场景**分开控制，因为代价完全不同**：
#   · PREVIEW_MULTI_IMAGE 走被动回复 —— 多图只多占几次回复额度，不占主动配额；
#   · RSS_MULTI_IMAGE 走主动消息 —— **每张图各占一条配额**，一条带 4 张图的
#     资讯就是 4 条（群维度 20 条/分钟 + 每日上限）。
# 觉得刷屏就关掉对应的那个，另一个不受影响。
PREVIEW_MULTI_IMAGE=true
RSS_MULTI_IMAGE=true

# 多图**合并成一条 markdown**（`msg_type=2`），而不是连发 N 条富媒体。
# 一条带 4 张图的资讯从 4 条消息变成 1 条 —— 省 3 份主动配额，也不刷屏。
#
# 图由 **QQ 的服务器自己去下载**（连发那条路其实也是，传的就是 url），
# 所以图必须 QQ 够得到。发之前会先探一次，抓不到的图直接剔掉并私聊告警。
# 关掉它就完全退回连发。
MULTI_IMAGE_MARKDOWN=true

# ---- markdown 多图预热：正式群推送前的两道预热 + 一道人工预览 ----
#
# **为什么需要**：QQ 的图片缓存是**服务端、跨群共享**的，但**冷链接第一次
# 渲染必炸**。2026-10-18 实测：一批 3.4 MB 的图 6 张全裂；同一批**同样的
# URL** 隔 20 秒发到**另一个群**，6 张全好。冷发那次一张都没抓下来
# （客户端上什么都没缓存），所以只可能是服务端。
#
# 流程：预热群发一条 → 等 PREVIEW_WARMUP_SEC → 预览群发一条（这条同时是
# **给你看的预览**）→ 等 PREVIEW_VETO_SEC，你在群里 @机器人 说「不发」
# 就挡下这一条不进正式群。
#
# ⚠️ 预热**必须是真的发一条 markdown**：`upload_image`（post_group_file +
# srv_send_msg=false）那条路预热不了 —— 生产里每条推送都逐张探过，照样裂。
#
# 两个群**都留空 = 整个机制关闭**，行为完全退回改动前。填的是 group_openid
# （不是群号），拿法：把机器人拉进群后看日志的「已记录新群」。
WARMUP_GROUP=
PREVIEW_GROUP=
# 预热①到预热②之间等多久。QQ 抓完图要时间，和图片总体积正相关：
# 实测 3.4 MB 约 20 秒够、5.7 MB 要 60 秒左右。图大就调大。
PREVIEW_WARMUP_SEC=45
# 预览发出去后等多久算「你没喊停」。这段时间正式群一条都不发。
PREVIEW_VETO_SEC=30

# 推送文案里带不带 RSS 摘要（`<description>` / `<summary>`）。
# 关掉就退回「📰 源名 / · 标题 / 链接」三行。
# 摘要截到 150 字，且开头和标题重复时会自动去掉那一段。
PUSH_SUMMARY=true

# 摘要显示多少字。**这不是 QQ 的限制** —— 实测中文 40000 字符平台照样收
# （scripts/probe_textlen.py）。纯粹是可读性：群里超过一屏就没人看了。
SUMMARY_CHARS=800
# 偶像大师官网 NEWS 的「企划 / 分类」标签，会渲染成
#   📰 NEWS | アイドルマスター
#   【灰姑娘】【演出/谷子】
#   · 标题...
# 那两个属性 RSS 里都没有（企划 CMS 不输出、分类只给日文原名），所以
# 开了它每次轮询会多调一次 CMS API。失败就静默不带标签，不影响推送。
IMAS_TAGS=true

# ===== 按群的功能开关（**不在 .env 里**）=====
#
# ⚠️ **这里没有任何 `*_GROUPS`。** 各功能的群列表存在**数据库**的
# `group_features` 表里，代码见 `src/qq_rss_bot/features.py`。
#
# 为什么不放 .env：`.env` 是 compose 的 `env_file`，环境变量在**创建容器时**
# 烘进去 —— 改一次群权限就得 `up -d --force-recreate` 重建容器。而机器人没法
# 重建自己的容器（要 root，而且那等于自杀），所以「在群里改开关」在 .env 上
# 根本做不到。落库之后**下一拍就生效**。
#
# ⚠️ 顺带一个好处是**没有静默失败**：曾经有过一版「.env 只用于首次灌入」，
# 毛病就是灌过之后改 .env 不再生效、而日志不报错。现在群列表只有库一个来源，
# 那个陷阱不存在了。
#
# 改群开关：**在群里发 `/set`**，出来的面板上就是六个功能的按钮
# （点按钮 → 指令填进输入框 → 按发送）。也可以手打 `/set <编号> on|off`。
# 改完**下一拍就生效**，不用重启。
#
# 没有群可发 / 要批量改时，直接改库：
#
#     sqlite3 data/bot.db \
#       "INSERT INTO group_features (group_openid, feature, enabled, updated_at) \
#        VALUES ('<群 openid>', 'morning', 1, datetime('now')) \
#        ON CONFLICT(group_openid, feature) DO UPDATE SET enabled = excluded.enabled"
#
#   关掉就把 enabled 写 0，或者直接 DELETE 那一行（效果一样）。
#   feature 的取值见 `src/qq_rss_bot/features.py` 的 FEATURES。
#
# 判据是启动日志这行（每个功能各几个群）：
#
#     功能开关：早安语音 2 个群；月曜が近いよ 2 个群；…
#
# ⚠️ 全新部署（空库）默认**一个群都不开** —— 刻意的，比「默认全开」安全。
# 先把机器人拉进群、有人 @ 一次让它认识这个群，再往库里写。

# ===== ASOBI TICKET 抽票提醒 =====
# 偶像大师各场 live 的抽选：什么时候开、什么时候截止、什么时候要入金。
#
# 数据源是 ASOBI TICKET 网站自己前端在调的那个接口（**完全公开、不用登录**）：
#   https://asobi-ticket.api.app.t-riple.com/api/v1/public/receptions
# 站点是 Angular SPA，列表页 DOM 里只有活动名和「受付中」，**日期全在接口里** ——
# 想抠 DOM 是抠不到的。接口支持 ETag，没变化时返回 304（0 字节），
# 所以 5 分钟查一次几乎不花什么。
#
# 开这个功能**必须填 TICKET_GROUPS**，留空等于整个功能关闭。
TICKET_ALERT=true

# 多久查一次（秒）。接口有 ETag，没变化时只有一次 304 的开销（实测 0.5 秒）。
TICKET_CHECK_SEC=300

# ⚠️ **判定用日本时间，显示用北京时间**，代码里写死了，这里不用配。
#    抽选截止是 23:59 JST，容器 TZ 是 Asia/Shanghai，差一小时 —— 按本地时间
#    算就是整整早一小时截止。所以比较一律走 JST；而显示给国内的人看，
#    统一转成北京时间（23:59 JST 显示成 22:59）。
#
# 推什么：新受付开的那一刻 / 申込截止前 24 小时 / 前 2 小时 /
#         入金截止前 24 小时 / 前 2 小时。
# **不推「当落発表」** —— 当落要自己上网站查（`/当落` 指令看有哪些在等）。
#
# 首次运行**只建 baseline、一条都不推**：否则当前正在受付的十几条会一次性
# 倒灌进群。但**締切提醒不建 baseline** —— 已经进 24h/2h 窗口的照推，
# 所以第一次启动就会看到几条，这是正常的。

# 品牌过滤：接口不支持按品牌筛，只能拿到全部再客户端筛。
# 判据是活动详情页 slug 的**前缀**（站点自己打的品牌标），**不是活动名**。
# 三个真实反例，名字里都没有 IDOLM@STER：
#   xR LIVE REVIVAL                              → idolmaster-261212       本家
#   ATHOME xR LIVE　Apple of my アイ              → cinderellagirls-270213  灰姑娘
#   shiny, the first REFRAC7IONS " Still blue "  → shinycolors-261219      闪耀色彩
# 改成按名字匹配会把这三种漏掉（也会把名字里带 IDOLM@STER 的联动活动误收）。
# 认不出来的前缀一律不推，但会在日志里留一条 INFO —— 将来出新品牌能看见。
TICKET_BRANDS=va-liv,cinderellagirls,idolmaster,sidem,shinycolors,765pro,gkmas,millionlive

# 消息里带不带封面图。**先开着测一下会不会不显示**，不显示就设成 false，
# 其余功能完全不受影响。列表是「每场 live 一张主视觉」，指令里一场一行一张图；
# 提醒那条是单条受付配这场的主视觉。封面在另一条接口（public/booths，17 场全有），
# 地址从 TICKET_URL 推出来，不需要额外配置。
TICKET_IMAGES=true

# 封面取哪个尺寸：
#   small     267×150    12 KB
#   medium    800×450   144 KB   ← 默认
#   large    1200×675   271 KB
#   original 1920×1080   1.8 MB
# **别用 original** —— 实测图片冷链接失败和体积强相关（1.6 MB 不炸、
# 3.4 MB 全炸），1.8 MB 正好落在这个区间里。
TICKET_IMAGE_SIZE=medium

# 封面**渲染宽度**（px）。
#
# ⚠️ QQ **不会**把小于气泡宽度的图放大 —— 尺寸提示写多少就渲染多少。所以
#    208（bilibili 封面用的那个值）在手机上的观感是「没占满气泡」。
#    到底多少才占满取决于你的设备，代码里猜不出来。跑一次这个：
#
#      uv run python scripts/probe_mdfmt.py --group <测试群 openid> --send
#
#    它会把**同一张图**按 208 / 320 / 480 / 640 发到测试群，你扫一眼哪一档
#    刚好贴齐气泡右边缘、哪一档开始溢出，把那个数填这里。
#    顺带还会发一条 markdown 语法 A/B（`#` 标题 / `>` 引用 / `-` 列表这些
#    从没验过，不能凭文档就写进生产文案）。
TICKET_IMAGE_W=320

# ===== 月曜が近いよ（每周定时的视频播报）=====
# 原型是 X 上的 @ChocodateMonday（シャニマス 的戏仿号）。**那个号 2026-09-27
# 已经停止活动**，所以这里不是「监控转发」，而是让机器人自己每周播一次：
# 周日 23:30 发「月曜が近いよ」+ 表情包一条、视频一条（两条消息）。
#
# 开这个功能**必须填 MONDAY_GROUPS**，留空等于整个功能关闭。
MONDAY_ENABLED=true
# 素材目录。**留空就跟着 DB_PATH 走** —— 容器里 DB_PATH=/app/data/bot.db，
# 所以默认是 /app/data/bot.db 旁边的 /app/data/monday，正好在挂载卷里。
#
# 目录里两类文件，**按后缀分**：
#   · .mp4                              → 视频，每周随机挑一个（避开上周那个）
#   · .png/.jpg/.jpeg/.gif/.webp        → 表情包，跟文案**同一条消息**发出去
# 表情包**按后缀认、不看文件名**（叫 `月曜が近いよ.jpg` 就行），放多张只发
# 排第一的那张并在日志里点名。**没有图片也能跑** —— 文案退化成纯文字。
#
# ⚠️ 机器人**发不了真·表情包**（QQ 的表情包是客户端的东西，bot API 里没有
#   对应的 msg_type），发出去的是**普通图片**。
MONDAY_VIDEO_DIR=

# ⚠️ **单个视频不能超过 10 MiB**，而且是**体积**不是时长 —— 实测：
#     5.8 KB ~ 9.86 MiB   ✅ 能传
#     10.11 MiB           ❌ 400 40093011
#     12.96 / 14.35 MiB   ❌ 400 40093011
#     19.5 / 26.0 MiB     ❌ 413（另一个坎：HTTP body 太大）
#   20 秒 / 5.57 MiB ✅ 而 2.8 秒 / 14.35 MiB ❌ —— **要压得压码率**，
#   压时长没用。超过上限的文件会被跳过并在日志里点名。
#   转小一点：ffmpeg -i in.mp4 -c:v libx264 -crf 26 -preset slow -c:a aac out.mp4
#
# ⚠️ 官方文档那句「file_data 需要在 5M 以内」**在视频这条路上不成立**
#   （5.85 MiB、13.8 MiB 的 base64 都传上去了）。那个 5M 只约束图片。

# 星期几。**口径同 datetime.weekday()：0=周一 … 6=周日。** 默认周日。
MONDAY_WEEKDAY=6
# 几点发，HH:MM。**本地时间（北京时间）**，不是日本时间 ——
# 抽票那套用 JST 是因为截止时刻本身是日本时间，两者别混。
MONDAY_TIME=23:30
# 容忍多久的调度抖动（秒）。**这不是补发窗口** —— 停机错过就跳过这一周，
# 所以别调成几千。只该覆盖轮询间隔（60 秒）。
MONDAY_WINDOW_SEC=180

# ===== 小偶像的每日早安语音 =====
#
# 每天早上 07:30 随机挑一位《偶像大师 闪耀色彩》的偶像，用她的声线说一句
# 带她口癖的日语早上好。**只有语音气泡，没有字幕。**
#
# ⚠️ **运行时零 TTS**：语音是**在 Mac 上离线预生成**的（scripts/make_morning.py），
#   容器只做「扫目录 → 读字节 → base64 → 上传」。所以这里**没有 Fish Audio
#   的 key、不需要装 pysilk、Fish Audio 挂了也不影响**。这是刻意的取舍 ——
#   否则每天 07:30 那一刻多一跳外网，一抖当天就没问候。
#
# 开这个功能**必须填 MORNING_GROUPS**，留空等于整个功能关闭。
# ⚠️ 这是**每天**在响，比月曜那种一周一次更需要先稳 ——**先只填测试群**。
MORNING_ENABLED=true
# 素材目录。**留空就跟着 DB_PATH 走** —— 容器里默认 /app/data/morning，
# 正好在挂载卷里。运行时只用里面的 `audio/`：
#
#     data/morning/audio/mano_0.silk       ← 櫻木真乃的第 0 条
#     data/morning/audio/hiori_3.silk
#
# ⚠️ **文件名必须是 `<偶像 id>_<序号>.silk`**，序号是数字。偶像 id 见
#   data/morning/source/characters.toml。名字不合规的文件会被跳过并在日志里点名。
#
# ⚠️ **`data/morning/` 整个不进 git**（`data/` 已在 .gitignore 里）：
#   `source/` 是从别人的 AGPL-3.0 仓库抓的资料，音色是社区上传到 Fish Audio
#   的公开模型，角色版权属于原作方。**别把它挪出 `data/`。**
#
# 同步：只要 `audio/`，别把 source/ 和 lines.toml 传上去（运行时用不到）。
MORNING_DIR=

# 几点发，HH:MM。**本地时间（北京时间）**，不涉及日本时间。
MORNING_TIME=07:30
# 容忍多久的调度抖动（秒）。**这不是补发窗口** —— 九点钟补一条「早上好」
# 比不补更怪，所以错过就当今天没发。只该覆盖轮询间隔（60 秒）。
MORNING_WINDOW_SEC=180
# 多久之内不重复同一位偶像。28 位轮一圈约一个月，7 天足够躲开「眼花」。
MORNING_RECENT_DAYS=7
#
# ⚠️ **QQ 的语音上传接口完全不校验格式**（2026-10-19 实测）：mp3 / wav / m4a、
#   甚至 `\x02#!SILK_V3` 后面接两千个零字节的**纯垃圾**，全都 HTTP 200 拿到
#   `file_info`。「上传成功」在这条路上**一点信息量都没有**，唯一的把关是
#   客户端侧的 silk 魔数闸（`morning.SILK_MAGIC`）——素材里混进非 silk 文件
#   的话，会被跳过并写一条 WARNING，日志里⻅ `早安：… 跳过了 N 个文件`。
#   （视频那条至少还有 10 MiB 的硬边界，语音这条连格式都不挡。）

# ===== 偶像生日推送 =====
#
# 每天 23:05（北京时间）推**第二天**的生日：名单来自冷数据，配图从
# https://x.com/imas_ch 当天那条祝贺推里抓。
#
# ⚠️ **23:05 推的是第二天的生日** —— 那正好是日本时间的当天 0 点，imas_ch
#   也在那个时刻发推（10-18 晚 23:00 发的是「10/19 お誕生日」）。
#   所以 10-18 晚上收到的是 **10-19** 的生日推送，库里也按 10-19 记。
#
# 名单和配图是**两条独立链路**：名单是冷数据（扒一次存着），配图每天实时抓。
# 抓不到图只是少一张图，**名单照样发**（窗口末尾退化成纯文字）。
#
# 开这个功能**必须填 BIRTHDAY_GROUPS**，留空等于整个功能关闭。
BIRTHDAY_ENABLED=true
# 冷数据目录。**留空就跟着 DB_PATH 走** —— 容器里默认 /app/data/birthday，
# 正好在挂载卷里。里面只需要 `birthdays.toml` 一个文件：
#
#     data/birthday/birthdays.toml
#
# 用 `uv run python scripts/fetch_birthday_source.py` 生成（扒
# https://imas-db.jp/calendar/birthdays.html，366 天 / 382 位偶像 / 313 位声优）。
# ⚠️ **`data/` 整个不进 git**，所以同步到 NAS 时要手动传这一次。
# ⚠️ 文件读不到时**功能关闭并打一条 ERROR**，不会连累机器人起不来 ——
#    但群里就是每天少一条推送，所以部署完记得看一眼启动日志。
BIRTHDAY_DIR=

# 几点发，HH:MM。**本地时间（北京时间）**。
BIRTHDAY_TIME=23:05
# 窗口（秒）。⚠️ **和 MORNING_WINDOW_SEC 不是一个意思**：早安是纯本地文件，
# 那个窗口只覆盖调度抖动；这里要**实时抓推文**，所以窗口同时是抓图的
# 补发窗口 —— 窗口内每拍重试，到窗口末尾还没抓到就**发纯文字**。
BIRTHDAY_WINDOW_SEC=300
#
# ⚠️ **容器直连 x.com / pbs.twimg.com 全不通**（SSL 握手超时 / DNS 被污染），
#   必须配下面的 MEDIA_PROXY。没配的症状是「每天都有文案、每天都没有图」。
#   客户端复用 `preview.make_client`，别另起一个。

# ===== 誕生祭 贺图聚合 =====
#
# 偶像生日那天，粉丝和画师会带 `#杜野凛世誕生祭2026` 这种 tag 发贺图。
# 每天定时搜这个话题，把点赞高的挑出来，**一张一条**发到群里（最多 6 条）。
#
# ⚠️ 收的是**当天**的贺图 —— 和上面那条生日推送**差一天**：
#   生日推送 23:05 推的是**第二天**的名单，这条 22:30 收的是**当天**的图。
#
# 开这个功能要同时满足：BIRTHDAY_ART_GROUPS 非空 **且** 下面两个 cookie 都填了。
# 缺一样整个功能就是关的（启动日志会写「未配置 X cookie，功能关闭」）。
BIRTHDAY_ART_ENABLED=true
# 几点收，HH:MM。**本地时间（北京时间）**。
#
# ⚠️ 用户原本定的是 12:00，改成了 22:30：贺图的发布高峰是**日本时间当天的
#   傍晚到深夜**（= 北京 17:00–23:00），北京中午去搜只捞得到当天上午那批，
#   画师还没画完。22:30 北京 = **23:30 JST**，生日当天基本收尾。
#   想改回去改这一个变量就行，代码不用动。
BIRTHDAY_ART_TIME=22:30

# 重试窗口（秒）。**不是补发窗口** —— 贺图早就躺在那儿了，这个窗口只用来
# 覆盖「搜索失败（网络抖 / 被限流）」时的重试。窗口内每拍重试，过了就当天不发了。
BIRTHDAY_ART_WINDOW_SEC=300

# 一天最多发几条（一条一张）。
BIRTHDAY_ART_MAX=6

# 点赞软下限。**真正起作用的是「按点赞取前 BIRTHDAY_ART_MAX」**，这个数只是
# 「别发一堆 0 赞垃圾」的兜底 —— 热度栏第二页实测能到 0 赞。
#
# 想让冷门偶像一张都不发就往上调（调到 2000 就是用户最初说的那个门槛，
# 但**只有热门 idol 撑得住**）；想「有多少发多少」就调到 0。
#
# （2026-10-20 更正：早先这里写「实测当天最高也就 464、按 2k 筛一条不剩」，
#   **那是错的** —— 见下面「搜索走 Top 栏」那段。杜野凛世当天 ≥2000 的有 6~8 条。）
BIRTHDAY_ART_MIN_LIKES=50

# 要不要排掉**官方号**（默认 true）。官方号发的是告知，不是粉丝贺图，
# ⚠️ 2026-10-22 起默认 **false**：官号不再整个丢掉，而是**单列一格**
# （官号 1 + 本人/声优 1 + 画师 4，某类空缺时名额回流给画师）。
# 设成 true 是逃生门 = 官方号一条都不要。
# 识别官号：库里的 [officials]（13 个品牌号）+ 显示名含「公式」+ 写死的旧表。
BIRTHDAY_ART_SKIP_OFFICIAL=false

# 额外要排掉的 handle，逗号分隔（不用写 @，大小写随意）。补官方号的漏网之鱼。
# 例：BIRTHDAY_ART_EXCLUDE=imas_ml_official,cg_official
BIRTHDAY_ART_EXCLUDE=

# markdown 预热群（空 = 不预热）。QQ 抓图是异步的，冷链接第一次不显示 ——
# 正式发之前先往这个群发一遍同样的内容，等 PREVIEW_WARMUP_SEC（默认 45）秒。
# 填一个测试群/专用群；**别填正式群**，否则正式群会先收到一遍预热副本。
BIRTHDAY_ART_WARMUP_GROUP=
#
# ⚠️ 这条路同样**必须走 MEDIA_PROXY**：容器直连 x.com 是 307 登录墙 +
#   SSL 超时，直连 pbs.twimg.com 是 DNS 被污染。
#
# ⚠️⚠️ **搜索走的是「Top」（热度）那一栏，不是「最新」。** 两者差一个数量级 ——
#   2026-10-19 杜野凛世实测（同 cookie、同 queryId）：
#     #杜野凛世誕生祭2026  Top: 39 条 中位 459 max 8591 ≥2000 的 6 条
#     #杜野凛世誕生祭2026  Latest: 34 条 中位  11 max 1119 ≥2000 的 0 条
#   代码里是 `PAGE_PLAN_YEARFUL = ("Top", "Top", "Latest")`，改它要连着
#   smoke 里那 5 条钉子一起改。

# ===== X 搜索凭据（誕生祭 贺图用）=====
#
# ⚠️⚠️ **这是真实凭据，两条硬规矩**：
#   1. **绝不提交** —— 仓库是公开的，`.env` 已在 .gitignore 里；
#   2. **绝不打印** —— 日志里只出现长度，别手动 `echo` 它。
#
# ⚠️ **用小号。** 拿账号 cookie 做自动化访问**违反 X 的条款**，有被封的风险。
#
# 拿法：浏览器登录 x.com → F12 → Application → Cookies → https://x.com
#   auth_token  40 字符（十六进制）
#   ct0         160 字符
#
# 失效的症状**在群里完全看不见**（就是「今天没图」，和「今天真没人画」一样），
# 所以代码里会**私聊告警**。换 cookie 后要
# `sudo docker compose up -d bot`（改 .env 必须重建容器，restart 不重读）。
auth_token=
ct0=

# 访问被墙站点（YouTube / X）用的出站代理，例如 http://192.168.0.63:6152
# 留空 = 直连 —— YouTube / X 预览、**生日推送的配图**、AI 摘要抓正文都会失效，
# 其余一切照常。
#
# 只给这两个站点用：RSSHub 是容器内部服务名（代理解析不了），QQ 的接口
# 在国内直连也更快 —— 所以 bot 的其余出站**一律不走代理**。
#
# 为什么非走代理不可、为什么封面要 base64 上传而不是给 QQ 一个 URL，
# 见 src/qq_rss_bot/preview.py 顶部的说明。
MEDIA_PROXY=

# ⚠️ 如果代理会做 **MITM**（Surge 就是），只配 MEDIA_PROXY 还不够 —— 它用自己的
# 根证书重签流量，而 httpx 默认只信 certifi 的 CA 列表，症状是
# `CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate chain`。
#
# 迷惑之处：**图能下、接口全挂**。实测 Surge 只 MITM 了 `www.youtube.com`，
# 没碰 `i.ytimg.com` / `api.fxtwitter.com`，所以图片那条路看起来完全正常。
#
# 两个办法，**优先用第一个**：
#   1. 把代理的根证书导出成 PEM，挂进容器后在这里指路径
#      （下面写的是容器里的路径，所以文件要放在挂载卷里，比如 data/ 下）
MEDIA_CA_BUNDLE=
#   2. 拿不到根证书时的逃生舱：干脆不校验。**它让这两个站点的流量裸奔**，
#      只在自建代理、且你清楚风险时才开。
MEDIA_INSECURE_TLS=false

# ===== AI 摘要（按源开关，默认所有源都是关的）=====
# 开一个源：/sub <路由> --ai   或   /ai <编号> on
# 关掉全部：留空 DEEPSEEK_API_KEY
#
# 它做什么：把文章正文交给模型 → 翻译标题 + 写 3~5 句中文摘要。
#
# ⚠️ 和 QQ 的字数限制**无关**：实测 QQ 单条消息能收 40000 字符
# （scripts/probe_textlen.py）。限制文案长度的从来不是平台，是可读性。
DEEPSEEK_API_KEY=
# 兼容任何 OpenAI 协议的端点。DeepSeek 国内直连 0.2 秒，**不要走 MEDIA_PROXY**。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名**要对着官方文档核**，写错是静默降级（症状：开了 AI 却没变化）。
# 2026-10-18 查证：deepseek-chat 已退役，现在只有下面这两个。
#   deepseek-flash      便宜，摘要够用
#   deepseek-v4-pro     贵一些
DEEPSEEK_MODEL=deepseek-flash

# 要不要抓文章页的正文。
#   false（默认）= 只用 RSS 的 <description>。很多源的导语**本身就是全文**
#                  （实测少数派 3914 字），再抓一遍纯属浪费一次请求和几秒延迟。
#   true         = 额外去抓 entry.link 的正文。只有 V2EX / Hacker News 这种
#                  「导语只有标题」的源才值得开。抓不到会静默退回导语。
AI_FETCH_ARTICLE=false

# DeepSeek 的 thinking **默认开着**，档位默认还是 high。
# 翻译+摘要不需要推理链，开着会白白多花 output token（thinking 按 output 计费）
# 并且每次多等 2~5 秒，所以默认关掉。
# ⚠️ 顺带一个坑：**thinking 模式下 temperature 是无效的**，关掉之后 0.3 才生效。
# 换成非 DeepSeek 的端点时，如果它不认 `thinking` 字段（OpenAI 会 400），
# 这里设成 false。
AI_DISABLE_THINKING=true

# **全局**日调用上限（不是每群）—— 花的是你自己的钱。缓存命中的不计数。
AI_DAILY_LIMIT=200

# ===== 主动消息节流 =====
# 官方频控：群维度 20 条/分钟、每群每天 1000 条。
# 下面两个是自设上限，默认留了余量给回执/提示这类消息。
# 超频控的后果是消息被平台丢弃，所以别调到官方值以上。
SEND_PER_MINUTE=20
DAILY_SEND_LIMIT=900

# 每群订阅数上限（0 = 不限）
MAX_SUBS_PER_GROUP=10

# 连续抓取失败多少次自动暂停该订阅，并私聊通知管理员
MAX_FAIL_BEFORE_PAUSE=5

# 出错私聊的收件人（逗号分隔的 openid）。**留空 = 自动登记群主和管理员**；
# 填了就是白名单，只发给名单上的人。openid 不是 QQ 号，见 README。
NOTIFY_OPENIDS=

# 机器人进新群时自动订阅的源（RSSHub 路由或完整 URL）。留空 = 关掉这个功能。
# 启动时还会给「一个订阅都没有」的已有群补上 —— 只补零订阅的，
# 免得把故意退订掉的群重新订回来。
# 例：AUTO_SUBSCRIBE_FEED=/idolmaster/news
AUTO_SUBSCRIBE_FEED=

# 日志同时写一份到文件（留空 = 只写 stdout）。
# 容器里建议开：docker logs 需要 root，写进挂载卷后普通账号也能读。
# LOG_FILE=/app/data/bot.log

# ===== 群复读机 =====
# 连着**两个人**发同样的话，机器人跟着复读一句（**第 2 个人**发出来才跟，
# 所以它不会自己起头；一个人连发两遍不算）。
#
# ⚠️ 这个功能和别的都不一样：**每条群消息都可能触发**，不是定时任务。
# 所以先只填测试群，确认频率合不合适再放开正式群。
# 留空 = 整个功能关闭。
REPEAT_ENABLED=true
# 超过这个长度就不跟（复读长文像刷屏）
REPEAT_MAX_LEN=200

# 同一个群两次复读之间的最小间隔（秒）。防的是「一群人反复刷同一句」。
REPEAT_GAP_SEC=20
